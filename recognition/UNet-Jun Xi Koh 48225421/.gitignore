# Git Ignore for PatternAnalysis-2025 Repository
# Excludes datasets, model files, and temporary files
# Keeps only code, scripts, and documentation

# ============================================================================
# DATASETS - DO NOT COMMIT
# ============================================================================

# HipMRI Study datasets
HipMRI_Study_open/
*/HipMRI_Study_open/
**/HipMRI_Study_open/

# Keras slices data
keras_slices_data/
*/keras_slices_data/
**/keras_slices_data/

# Other medical imaging datasets
*.nii
*.nii.gz
*.nifti
*.dcm
*.dicom
*.mhd
*.mha
*.raw

# Generic data directories
data/
datasets/
*/data/
**/data/
*/datasets/
**/datasets/

# ============================================================================
# MODEL FILES - DO NOT COMMIT
