# GPU memory traces
*.ncu-rep
*.nvvp

# Tensorboard logs
runs/
*/runs/
**/runs/

# Weights and Biases
wandb/
*/wandb/
**/wandb/

# ============================================================================
# ALLOW EXCEPTIONS (DO COMMIT)
# ============================================================================

# These are important for reproducibility and should be committed:

# Python requirements (KEEP - needed for installation)
!requirements.txt
!environment.yml
!setup.py
!setup.cfg

# Documentation (KEEP - needed for README)
!README.md
!*.md
!docs/

# Source code (KEEP - this is the main deliverable)
!*.py
!*.sh

# Configuration files (KEEP - needed for reproducibility)
!*.json
!*.yaml
!*.yml
!*.toml
!*.cfg
!*.ini

# License and project files (KEEP)
!LICENSE
!.gitignore
!.gitattributes

# Sample/example files (KEEP - can be small)
# Uncomment if you have important example files:
# !examples/
# !data/sample/
